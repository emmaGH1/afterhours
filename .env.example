# Server-only. Generate a trial key in Pyth Terminal; never expose it with NEXT_PUBLIC_.
PYTH_PRO_API_KEY=

# Required for live Pyth mode. Supply only IDs verified against the entitled
# Pyth Pro catalog for this deployment. AAPLX-test is an internal devnet token;
# it is not evidence of a Pyth feed or a backed security.
PYTH_AAPL_FEED_ID=
PYTH_AAPLX_FEED_ID=

# Optional override. Defaults to Solana devnet's public RPC during development.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only SERV Reasoning credential. Never prefix with NEXT_PUBLIC_.
OPENSERV_API_KEY=

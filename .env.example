# Server-only SERV Reasoning credential for the Review Desk. Never prefix with NEXT_PUBLIC_.
OPENSERV_API_KEY=

# Server-only read-only RPC used to collect one confirmed reserve observation.
SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# Optional browser-wallet RPC override. Defaults to Solana devnet during development.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional deployment URL used by page metadata when no platform URL is provided.
NEXT_PUBLIC_SITE_URL=

# Legacy Pyth diagnostics only; the shipped Review Desk does not use live Pyth data.
# AAPLX-test is an internal devnet token, not evidence of a Pyth feed or backed security.
PYTH_PRO_API_KEY=
PYTH_AAPL_FEED_ID=
PYTH_AAPLX_FEED_ID=
